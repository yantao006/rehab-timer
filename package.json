{
  "name": "rehab-timer",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:publish": "node scripts/build.mjs --publish",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "validate": "npm run check && npm test && git diff --check",
    "wrangler": "wrangler"
  },
  "devDependencies": { "wrangler": "4.95.0" }
}
